NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, bypasses RLS. Used by the moderator
# "Reset calendar data" action and any future admin-only operations.
# Get it from: Supabase dashboard → Project Settings → API → "service_role" secret.
# Do NOT prefix with NEXT_PUBLIC_ and do NOT commit a real value to git.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key — used to email finalized/cancelled meeting invites with .ics
# attachments to all members. Get it from: https://resend.com/api-keys.
# Server-only — do NOT prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
